task.spawn(function()
    -- Announce which transport we resolved, so debugging is trivial.
    if RequestFn then
        print("📡 [Tester] HTTP transport: executor request()")
    else
        print("📡 [Tester] HTTP transport: game:HttpGet fallback (GET only)")
    end
    AddFeed("• listening on room \"" .. CONFIG.ROOM .. "\"", SUBTEXT)

    while running and sg.Parent do
        local url = BuildURL("/state", {
            room  = CONFIG.ROOM,
            since = lastSeq,
            wait  = CONFIG.LONGPOLL,
            key   = CONFIG.KEY,
        })

        local ok, body = HttpGet(url)

        if ok and body then
            local data = JSONDecode(body)
            if data and data.ok then
                failures = 0
                if data.seq ~= lastSeq then
                    lastSeq = data.seq
                    ApplyState(data)
                end
                SetLive(true, "🟢 Live · room \"" .. tostring(data.room) .. "\" · seq " .. tostring(data.seq))
            else
                failures = failures + 1
                SetLive(false, "⚠️ Bad response from relay")
            end
        else
            failures = failures + 1
            SetLive(false, "🔴 Relay unreachable (" .. tostring(body) .. ")")
            if failures == 1 then
                AddFeed("✕ cannot reach " .. CONFIG.RELAY_URL, BTNRED)
            end
        end

        -- Back off on repeated failure so we don't spam a dead relay.
        if failures > 0 then
            task.wait(math.min(1 + failures * 1.5, 10))
        else
            task.wait(0.15)
        end
    end
end)

